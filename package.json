{
  "name": "yumly",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:shared": "yarn workspace @yumly/shared build",
    "lint": "turbo run lint",
    "api:dev": "yarn workspace @yumly/api dev",
    "web:dev": "yarn workspace @yumly/web dev"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
